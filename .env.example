# PlantAI — environment template (committed). Copy to .env.local and fill in.
#
# SECURITY (SECURITY.md §2): NEVER commit .env.local, NEVER paste real keys
# into chat or screenshots. `.env.example` keeps placeholders only.

# --- App (safe to be public) ---
# Production base URL of the site; e.g. https://your-site.netlify.app or your
# custom domain. Local dev can leave this unset (falls back to localhost).
NEXT_PUBLIC_SITE_URL=

# --- Supabase (public-by-design pair; safe for the browser under RLS) ---
# Supabase dashboard → plantai-dev → Project settings → Data API / API keys
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY

# --- Supabase privileged key (SECRET — server-only. Never prefix with NEXT_PUBLIC_) ---
# Canonical name (Supabase docs 2026): SUPABASE_SECRET_KEY with an `sb_secret_...`
# value from Dashboard → Project Settings → API Keys. It resolves to the
# service_role Postgres role (bypasses RLS) — needed for identifications
# persistence + identification_cache. The legacy SUPABASE_SERVICE_ROLE_KEY
# JWT is deprecated by Supabase by end of 2026 but is still accepted as a
# fallback by this codebase.
SUPABASE_SECRET_KEY=

# --- Pl@ntNet (SECRET — server-only) ---
# Get a free key at my.plantnet.org → settings → API key (free plan: 500
# identifications/day). Live identification requires BOTH an explicit mode
# and a valid key:
#   PLANTNET_MODE=live
#   PLANTNET_API_KEY=<owner-managed server-only value>
# A key by itself is NOT enough: missing, invalid or `mock` mode always uses
# the built-in mock provider. Keep PLANTNET_MODE=mock for local/audit work.
#
# PRODUCTION: live identification must never be enabled without separate
# owner approval. Do not set PLANTNET_MODE=live in production until approved.
PLANTNET_MODE=mock
PLANTNET_API_KEY=
# PLANTNET_MODE=live

# --- Identification persistence write control (server-only) ---
# SAFE DEFAULT: OFF. Automatic database writes from the identification
# pipeline (identifications INSERT, identification_cache upsert, hit_count
# UPDATE) happen ONLY when this is set to the exact string "true" in
# server-side environment configuration. Missing, blank, invalid, or any
# other value keeps writes disabled. Mock and live identification both
# work normally either way; responses are unaffected. Enabling automatic
# writes is a separate owner decision — do not flip this casually.
PLANTAI_PERSISTENCE_ENABLED=false

# --- Rate limiting privacy salt (server-only; Phase 2) ---
# Salt for the salted-SHA-256 IP hash used by the anonymous daily identify
# counter (raw IPs are never logged — SECURITY.md §7). Generate once, e.g.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If unset, a per-process ephemeral salt is used (counters stay correct
# within one instance but differ across instances/restarts).
IP_HASH_SALT=
